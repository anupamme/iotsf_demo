\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces All 31 intervention cells (the 31 of 32 screened cells with a paired B/D run): \textbf  {selection-split} gate $V_{\text  {ridge}}$ (the primary gate of \S  \ref {sec:forecasting:gate}, scored on windows disjoint from the outcome columns beside it), then B$-$D on validation and on held-out windows (positive ${=}$ the frozen encoder was better), and whether the validation and held-out readings disagree in sign. Every row names its own $n$ because $n$ is \emph  {not} constant down the column: the ETTh2 spectrum cells ran at 500 while their same-dataset neighbours ran at 1{,}000, and a row that stayed silent would read as sharing its neighbour's. ILI is the one cell with no cap: it trains on its whole 452-window split, since it is the only series small enough, so its $n$ is a size rather than a subsample. Generated by \texttt  {scripts/cell\_matrix.py --latex}.}}{22}{table.caption.12}\protected@file@percent }
\newlabel{tab:heldout_all}{{5}{22}{All 31 intervention cells (the 31 of 32 screened cells with a paired B/D run): \textbf {selection-split} gate $\Vb {\text {ridge}}$ (the primary gate of \S \ref {sec:forecasting:gate}, scored on windows disjoint from the outcome columns beside it), then B$-$D on validation and on held-out windows (positive ${=}$ the frozen encoder was better), and whether the validation and held-out readings disagree in sign. Every row names its own $n$ because $n$ is \emph {not} constant down the column: the ETTh2 spectrum cells ran at 500 while their same-dataset neighbours ran at 1{,}000, and a row that stayed silent would read as sharing its neighbour's. ILI is the one cell with no cap: it trains on its whole 452-window split, since it is the only series small enough, so its $n$ is a size rather than a subsample. Generated by \texttt {scripts/cell\_matrix.py --latex}}{table.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {The four sign reversals between selection and held-out windows} (\S  \ref {sec:analysis:heldout}). $\Delta $ adapted and $\Delta $ frozen are the change in each arm's forgetting when scoring moves from the selection split to the held-out split; $\text  {zs}_\text  {test}/\text  {zs}_\text  {val}$ is the untrained checkpoint's error ratio between the two splits, an exchangeability check that involves no fine-tuning. All four reversals run from ``frozen better'' to ``adapted better''. $n$ is per row and not constant (Table~\ref {tab:heldout_all}), and is taken from the published row rather than re-read here. Generated by \texttt  {scripts/heldout\_decomposition.py}.}}{23}{table.caption.13}\protected@file@percent }
\newlabel{tab:heldout_decomp}{{6}{23}{\textbf {The four sign reversals between selection and held-out windows} (\S \ref {sec:analysis:heldout}). $\Delta $ adapted and $\Delta $ frozen are the change in each arm's forgetting when scoring moves from the selection split to the held-out split; $\text {zs}_\text {test}/\text {zs}_\text {val}$ is the untrained checkpoint's error ratio between the two splits, an exchangeability check that involves no fine-tuning. All four reversals run from ``frozen better'' to ``adapted better''. $n$ is per row and not constant (Table~\ref {tab:heldout_all}), and is taken from the published row rather than re-read here. Generated by \texttt {scripts/heldout\_decomposition.py}}{table.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Cross-backbone results ($h{=}24$)} (\S  \ref {sec:forecasting:nonmoirai}). Every non-Moirai cell with a paired frozen-encoder run: \textbf  {selection-split} gate $V_{\text  {ridge}}$ (\textsuperscript  {f}${=}$gate-fail at the $0.20$ operating point; all nine fail, as does the screened-only TimesFM/Electricity cell, which has no paired run and so no selection-split gate: it scores $+0.132$ on the held-out windows), CKA after full fine-tuning, and the two outcome readings as \% change against zero-shot (\emph  {negative is better than zero-shot}). \textbf  {Protocol note:} this arm is univariate OT, lookback 96, $h{=}24$, 200 held-out windows, per-window $z$-scored; the Moirai arm of \S  \ref {sec:forecasting} is lookback 192, $h{=}96$, 300 windows, train-normalised. Gates for both arms come from one source (\texttt  {results/gate\_val\_side.json}, via \texttt  {scripts/cell\_matrix.py}); the two arms are never pooled.}}{23}{table.caption.15}\protected@file@percent }
\newlabel{tab:crossbackbone}{{7}{23}{\textbf {Cross-backbone results ($h{=}24$)} (\S \ref {sec:forecasting:nonmoirai}). Every non-Moirai cell with a paired frozen-encoder run: \textbf {selection-split} gate $\Vb {\text {ridge}}$ (\textsuperscript {f}${=}$gate-fail at the $0.20$ operating point; all nine fail, as does the screened-only TimesFM/Electricity cell, which has no paired run and so no selection-split gate: it scores $+0.132$ on the held-out windows), CKA after full fine-tuning, and the two outcome readings as \% change against zero-shot (\emph {negative is better than zero-shot}). \textbf {Protocol note:} this arm is univariate OT, lookback 96, $h{=}24$, 200 held-out windows, per-window $z$-scored; the Moirai arm of \S \ref {sec:forecasting} is lookback 192, $h{=}96$, 300 windows, train-normalised. Gates for both arms come from one source (\texttt {results/gate\_val\_side.json}, via \texttt {scripts/cell\_matrix.py}); the two arms are never pooled}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {Mitigation spectrum on Moirai-Small/ETTh2.} Rows ordered by representation preservation (CKA at $h{=}96$). On \emph  {this} cell LoRA preserves representations (CKA${\approx }0.98$) while \emph  {improving} on zero-shot, and weight anchoring reduces drift without buying utility. \textbf  {Neither reading generalises, and we checked rather than assumed:} extending condition~E to 8 further value-cells (Appendix~\ref {app:loravaluecells}) puts CKA$_\text  {E}$ anywhere from $0.55$ to $0.97$ and leaves full fine-tuning ahead of LoRA on 4 of the 8. \textbf  {Every row is scored against its own zero-shot.} Forgetting\% is the mean over seeds of each run's $(\text  {fine-tuned}-\text  {zero-shot})/ \text  {zero-shot}$, so no row borrows another's denominator; earlier versions of this table divided the anchoring and LoRA rows by a single shared value and read up to $3.4$~pp away as a result. MSE, CKA and $\ell _2$ drift are means over seeds with population std (ddof${=}0$); the body's SEM convention (\S  \ref {sec:method}) does not apply here. \textbf  {The rows are not matched on training-set size.} Conditions B, C and D use $n{=}500$ training samples (zero-shot MSE $.1256$ at $h{=}96$, $.1580$ at $h{=}192$); E, F and G use $n{=}1{,}000$ (zero-shot MSE $.1274$ and $.1596$); the two rightmost columns give the seed count and the training-set size separately. We therefore claim no ordering \emph  {between} the two groups: there is no full-fine-tuning arm at $n{=}1{,}000$ on this cell with more than a single seed, so ``anchoring ties full fine-tuning'' is not a comparison these runs support. The dissociation the table is cited for (CKA not predicting utility) is within-group and unaffected. Condition~D reads CKA $0.99996$ rather than $1$: it leaves \texttt  {in\_proj} and \texttt  {mask\_encoding} trainable, so it is a frozen-\emph  {encoder} control and not a strict freeze. Only condition~H (Appendix~\ref {app:strictfreeze}) is $1.0000$ by construction. Earlier versions of this table printed D as $1.000$, which rounded that distinction away.}}{24}{table.caption.17}\protected@file@percent }
\newlabel{tab:mitigation_spectrum}{{8}{24}{\textbf {Mitigation spectrum on Moirai-Small/ETTh2.} Rows ordered by representation preservation (CKA at $h{=}96$). On \emph {this} cell LoRA preserves representations (CKA${\approx }0.98$) while \emph {improving} on zero-shot, and weight anchoring reduces drift without buying utility. \textbf {Neither reading generalises, and we checked rather than assumed:} extending condition~E to 8 further value-cells (Appendix~\ref {app:loravaluecells}) puts CKA$_\text {E}$ anywhere from $0.55$ to $0.97$ and leaves full fine-tuning ahead of LoRA on 4 of the 8. \textbf {Every row is scored against its own zero-shot.} Forgetting\% is the mean over seeds of each run's $(\text {fine-tuned}-\text {zero-shot})/ \text {zero-shot}$, so no row borrows another's denominator; earlier versions of this table divided the anchoring and LoRA rows by a single shared value and read up to $3.4$~pp away as a result. MSE, CKA and $\ell _2$ drift are means over seeds with population std (ddof${=}0$); the body's SEM convention (\S \ref {sec:method}) does not apply here. \textbf {The rows are not matched on training-set size.} Conditions B, C and D use $n{=}500$ training samples (zero-shot MSE $.1256$ at $h{=}96$, $.1580$ at $h{=}192$); E, F and G use $n{=}1{,}000$ (zero-shot MSE $.1274$ and $.1596$); the two rightmost columns give the seed count and the training-set size separately. We therefore claim no ordering \emph {between} the two groups: there is no full-fine-tuning arm at $n{=}1{,}000$ on this cell with more than a single seed, so ``anchoring ties full fine-tuning'' is not a comparison these runs support. The dissociation the table is cited for (CKA not predicting utility) is within-group and unaffected. Condition~D reads CKA $0.99996$ rather than $1$: it leaves \texttt {in\_proj} and \texttt {mask\_encoding} trainable, so it is a frozen-\emph {encoder} control and not a strict freeze. Only condition~H (Appendix~\ref {app:strictfreeze}) is $1.0000$ by construction. Earlier versions of this table printed D as $1.000$, which rounded that distinction away}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces \textbf  {The pre-registered prospective test.} Predictions frozen in git before any condition-B or -D run for these cells existed. ``Degradation'' applies the paper's own definition unchanged: gate-passing $\wedge $ forg$_\text  {B}{>}0$ in every seed $\wedge $ forg$_\text  {D}{<}0$ in every seed. gate$_\text  {pre}$ is the frozen predictor's score, on the pre-correction denominator; gate$_\text  {val}$ is the corrected selection-split gate of \S  \ref {sec:forecasting}.}}{24}{table.caption.19}\protected@file@percent }
\newlabel{tab:prospective}{{9}{24}{\textbf {The pre-registered prospective test.} Predictions frozen in git before any condition-B or -D run for these cells existed. ``Degradation'' applies the paper's own definition unchanged: gate-passing $\wedge $ forg$_\text {B}{>}0$ in every seed $\wedge $ forg$_\text {D}{<}0$ in every seed. gate$_\text {pre}$ is the frozen predictor's score, on the pre-correction denominator; gate$_\text {val}$ is the corrected selection-split gate of \S \ref {sec:forecasting}}{table.caption.19}{}}
