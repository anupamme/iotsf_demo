\@writefile{toc}{\contentsline {section}{\numberline {A22}Paired Inference on Encoder Adaptation, and What These Seed Counts Can Resolve}{42}{appendix.V}\protected@file@percent }
\newlabel{app:pairedinference}{{A22}{42}{Paired Inference on Encoder Adaptation, and What These Seed Counts Can Resolve}{appendix.V}{}}
\@writefile{lot}{\contentsline {table}{\numberline {24}{\ignorespaces \textbf  {Paired seed-level inference on encoder adaptation.} $\Delta _\text  {enc}={L_\text  {full}}-{L_\text  {frozen}}$ per seed, in percent of the cell's zero-shot reference, so a positive value means allowing the encoder to adapt made the cell \emph  {worse}. B and D share a seed, an initialisation and a window sample, so this contrast is paired by construction. $d$ is paired Cohen's $d$; dispersion is SEM, matching the body convention (\S  \ref {sec:method}) and not the population std the stored JSON fields use. Each row names its own $n$, which is not constant down the column (Table~\ref {tab:heldout_all}). \textbf  {Two tests, because neither alone is adequate at these seed counts.} $p_\text  {exact}$ enumerates all $2^N$ sign assignments, so it assumes nothing---but its resolution is fixed by $N$: the smallest two-sided value an $N$-seed cell can produce is $2/2^N$, which is $0.25$ at $N{=}3$ and $0.0625$ at $N{=}5$. The 24 cells at $N{=}3$ therefore \emph  {cannot} reach $p<0.05$ however large or consistent their effect, and a non-significant exact $p$ on those cells is a statement about seed budget rather than about the effect. The CI and $p_t$ are the paired $t$ versions, which do resolve at $N{=}3$ and pay for it with a normality assumption on three points that cannot be checked. Where the two agree the reading does not rest on that assumption; where they disagree, the evidence is assumption-dependent and is treated as such in the text. We do \emph  {not} report a percentile bootstrap interval here: every resample mean lies within the range of the observations, so at $N{=}3$ with all seeds on one side of zero such an interval excludes zero by construction, restating the sign count it was meant to improve on. It is kept in \texttt  {results/paired\_inference.json} for the larger cells. In the two summary rows the last column is \emph  {not} an effect size: it gives the number of cells whose mean $\Delta _\text  {enc}$ is positive, out of the cells in that row. $\dagger $ marks cells clearing the gate threshold under at least one admissible baseline of the ladder (Appendix~\ref {app:baselines}). $\ddagger $ marks the Chronos cells, whose per-condition forgetting is confounded by the head/decoder mismatch; their $\Delta _\text  {enc}$ is unaffected.}}{43}{table.caption.32}\protected@file@percent }
\newlabel{tab:paired_inference}{{24}{43}{\textbf {Paired seed-level inference on encoder adaptation.} $\Delta _\text {enc}={L_\text {full}}-{L_\text {frozen}}$ per seed, in percent of the cell's zero-shot reference, so a positive value means allowing the encoder to adapt made the cell \emph {worse}. B and D share a seed, an initialisation and a window sample, so this contrast is paired by construction. $d$ is paired Cohen's $d$; dispersion is SEM, matching the body convention (\S \ref {sec:method}) and not the population std the stored JSON fields use. Each row names its own $n$, which is not constant down the column (Table~\ref {tab:heldout_all}). \textbf {Two tests, because neither alone is adequate at these seed counts.} $p_\text {exact}$ enumerates all $2^N$ sign assignments, so it assumes nothing---but its resolution is fixed by $N$: the smallest two-sided value an $N$-seed cell can produce is $2/2^N$, which is $0.25$ at $N{=}3$ and $0.0625$ at $N{=}5$. The 24 cells at $N{=}3$ therefore \emph {cannot} reach $p<0.05$ however large or consistent their effect, and a non-significant exact $p$ on those cells is a statement about seed budget rather than about the effect. The CI and $p_t$ are the paired $t$ versions, which do resolve at $N{=}3$ and pay for it with a normality assumption on three points that cannot be checked. Where the two agree the reading does not rest on that assumption; where they disagree, the evidence is assumption-dependent and is treated as such in the text. We do \emph {not} report a percentile bootstrap interval here: every resample mean lies within the range of the observations, so at $N{=}3$ with all seeds on one side of zero such an interval excludes zero by construction, restating the sign count it was meant to improve on. It is kept in \texttt {results/paired\_inference.json} for the larger cells. In the two summary rows the last column is \emph {not} an effect size: it gives the number of cells whose mean $\Delta _\text {enc}$ is positive, out of the cells in that row. $\dagger $ marks cells clearing the gate threshold under at least one admissible baseline of the ladder (Appendix~\ref {app:baselines}). $\ddagger $ marks the Chronos cells, whose per-condition forgetting is confounded by the head/decoder mismatch; their $\Delta _\text {enc}$ is unaffected}{table.caption.32}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A23}The Graded Value Axis: Is the Dissociation Confined to Cells With Nothing to Lose?}{44}{appendix.W}\protected@file@percent }
\newlabel{app:valueaxis}{{A23}{44}{The Graded Value Axis: Is the Dissociation Confined to Cells With Nothing to Lose?}{appendix.W}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Neither drift nor measured pre-trained value orders the encoder intervention.} Both panels share $y{=}$ held-out $\Delta _\text  {enc}$ (positive $=$ freezing the encoder did better). Point area is proportional to the graded value score in \emph  {both} panels, so the left panel answers the objection visually: if drift predicted the outcome wherever there was something to lose, the large points would trend and the small ones would scatter. Backbone is encoded by colour \emph  {and} marker because CKA is not comparable across architectures, which is why the pooled left-panel interval must not be read as a within-backbone one. Drawn by \texttt  {paper\_8/fig\_value\_axis.py} from \texttt  {results/value\_axis.json}; the script asserts its own counts against that file and fails rather than drawing a figure that disagrees with this text.}}{44}{figure.caption.33}\protected@file@percent }
\newlabel{fig:valueaxis}{{4}{44}{\textbf {Neither drift nor measured pre-trained value orders the encoder intervention.} Both panels share $y{=}$ held-out $\denc $ (positive $=$ freezing the encoder did better). Point area is proportional to the graded value score in \emph {both} panels, so the left panel answers the objection visually: if drift predicted the outcome wherever there was something to lose, the large points would trend and the small ones would scatter. Backbone is encoded by colour \emph {and} marker because CKA is not comparable across architectures, which is why the pooled left-panel interval must not be read as a within-backbone one. Drawn by \texttt {paper\_8/fig\_value\_axis.py} from \texttt {results/value\_axis.json}; the script asserts its own counts against that file and fails rather than drawing a figure that disagrees with this text}{figure.caption.33}{}}
\@writefile{lot}{\contentsline {table}{\numberline {25}{\ignorespaces \textbf  {The dependence, estimated two ways.} Rank rows are Spearman $\rho $ with $10{,}000$ bootstrap draws over $(\text  {backbone}, \text  {dataset})$ clusters, seed~$0$. The slope rows fit all cells at once with backbone identity absorbed as a fixed effect and both regressors centred, so $b_1$ is the CKA slope \emph  {at mean value}; $b_3$ is the quantity at issue. Emitted by \texttt  {scripts/value\_axis.py --latex}, which delegates the slope fit to \texttt  {scripts/cka\_fixed\_effects.py} rather than refitting it.}}{45}{table.caption.34}\protected@file@percent }
\newlabel{tab:valueaxis}{{25}{45}{\textbf {The dependence, estimated two ways.} Rank rows are Spearman $\rho $ with $10{,}000$ bootstrap draws over $(\text {backbone}, \text {dataset})$ clusters, seed~$0$. The slope rows fit all cells at once with backbone identity absorbed as a fixed effect and both regressors centred, so $b_1$ is the CKA slope \emph {at mean value}; $b_3$ is the quantity at issue. Emitted by \texttt {scripts/value\_axis.py --latex}, which delegates the slope fit to \texttt {scripts/cka\_fixed\_effects.py} rather than refitting it}{table.caption.34}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A24}Cross-Cell Statistics, and a Pooled Analysis We Do Not License}{45}{appendix.X}\protected@file@percent }
\newlabel{app:crosscell}{{A24}{45}{Cross-Cell Statistics, and a Pooled Analysis We Do Not License}{appendix.X}{}}
\@writefile{lot}{\contentsline {table}{\numberline {26}{\ignorespaces Is the pooled CKA correlation a backbone artefact? The same statistic (Spearman $\rho $ of CKA against held-out B$-$D, $10{,}000$-resample bootstrap CI) computed pooled and then stratified by backbone, at both resampling levels. ``Cl.'' is the number of $(\text  {backbone}, \text  {dataset})$ clusters, which is the effective sample size for the clustered interval and is far below $n$. Values are emitted by \texttt  {scripts/clustered\_inference.py}. The pooled row is reported for audit, not read as evidence; the two small arms carry essentially no information at their cell counts, and for them the two levels coincide because every cell is already its own cluster.}}{46}{table.caption.35}\protected@file@percent }
\newlabel{tab:crosscell}{{26}{46}{Is the pooled CKA correlation a backbone artefact? The same statistic (Spearman $\rho $ of CKA against held-out B$-$D, $10{,}000$-resample bootstrap CI) computed pooled and then stratified by backbone, at both resampling levels. ``Cl.'' is the number of $(\text {backbone}, \text {dataset})$ clusters, which is the effective sample size for the clustered interval and is far below $n$. Values are emitted by \texttt {scripts/clustered\_inference.py}. The pooled row is reported for audit, not read as evidence; the two small arms carry essentially no information at their cell counts, and for them the two levels coincide because every cell is already its own cluster}{table.caption.35}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A25}Is the Reading Specific to CKA? Six Measures on 59 Encoders}{47}{appendix.Y}\protected@file@percent }
\newlabel{app:driftmetrics}{{A25}{47}{Is the Reading Specific to CKA? Six Measures on 59 Encoders}{appendix.Y}{}}
\@writefile{lot}{\contentsline {table}{\numberline {27}{\ignorespaces \textbf  {Six measures of representation change on 59 Moirai-Small encoders.} All computed on identical windows and identical pooling. ``$\rho $ with CKA'' is the rank correlation of each measure with linear CKA over the 59 encoders; the last two columns correlate each measure with forgetting, pooled and then within each of the six groups of at least five encoders. Forgetting here is the \emph  {selection-split} figure---these runs stored no zero-shot test MSE, so a held-out contrast cannot be reconstructed from them, and \S  \ref {sec:analysis:heldout} shows same-split scoring can invert the sign of the intervention. This arm is therefore a comparison of measures, not a held-out claim. Emitted by \texttt  {scripts/drift\_metric\_battery.py}; the pooled column mixes three datasets and is descriptive for the reason Appendix~\ref {app:crosscell} gives about pooling.}}{47}{table.caption.36}\protected@file@percent }
\newlabel{tab:driftmetrics}{{27}{47}{\textbf {Six measures of representation change on 59 Moirai-Small encoders.} All computed on identical windows and identical pooling. ``$\rho $ with CKA'' is the rank correlation of each measure with linear CKA over the 59 encoders; the last two columns correlate each measure with forgetting, pooled and then within each of the six groups of at least five encoders. Forgetting here is the \emph {selection-split} figure---these runs stored no zero-shot test MSE, so a held-out contrast cannot be reconstructed from them, and \S \ref {sec:analysis:heldout} shows same-split scoring can invert the sign of the intervention. This arm is therefore a comparison of measures, not a held-out claim. Emitted by \texttt {scripts/drift\_metric\_battery.py}; the pooled column mixes three datasets and is descriptive for the reason Appendix~\ref {app:crosscell} gives about pooling}{table.caption.36}{}}
