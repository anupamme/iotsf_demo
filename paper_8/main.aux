\@writefile{lot}{\contentsline {table}{\numberline {37}{\ignorespaces \textbf  {The pre-registered positive control: 21 runs, no destruction.} Task A is Moirai-Small/ETTh2 $h{=}192$; task B is the anti-persistent synthetic series, fixed by SHA-256 before any run. ``task B learned'' is the MSE reduction on B's own held-out windows (registered validity threshold $20\%$). ``retention on task A'' is $100(\text  {MSE}_A(\theta _\text  {FT}) - \text  {MSE}_A(\theta _\text  {ZS}))/\text  {MSE}_A(\theta _\text  {ZS})$, so \emph  {positive is worse} and the registered destruction threshold is $+50\%$ in a majority of seeds under full fine-tuning. CKA is measured on \textbf  {task A's} inputs. $\pm $ is the SEM over 3 seeds. $^{\dagger }$ marks the single declared ladder extension. Read every retention number against the $0.48$~pp evaluator noise floor derived in the text.}}{66}{table.caption.50}\protected@file@percent }
\newlabel{tab:poscontrol}{{37}{66}{\textbf {The pre-registered positive control: 21 runs, no destruction.} Task A is Moirai-Small/ETTh2 $h{=}192$; task B is the anti-persistent synthetic series, fixed by SHA-256 before any run. ``task B learned'' is the MSE reduction on B's own held-out windows (registered validity threshold $20\%$). ``retention on task A'' is $100(\text {MSE}_A(\theta _\text {FT}) - \text {MSE}_A(\theta _\text {ZS}))/\text {MSE}_A(\theta _\text {ZS})$, so \emph {positive is worse} and the registered destruction threshold is $+50\%$ in a majority of seeds under full fine-tuning. CKA is measured on \textbf {task A's} inputs. $\pm $ is the SEM over 3 seeds. $^{\dagger }$ marks the single declared ladder extension. Read every retention number against the $0.48$~pp evaluator noise floor derived in the text}{table.caption.50}{}}
\gdef \@abspage@last{66}
