\@writefile{lot}{\contentsline {table}{\numberline {36}{\ignorespaces Within-backbone slope of held-out B$-$D on CKA, in percentage points per unit of CKA, with backbone identity absorbed as a fixed effect rather than by subsetting. Intervals are $10{,}000$ cluster-bootstrap draws over the 15 $(\text  {backbone}, \text  {dataset})$ clusters of 31 cells; draws in which the fixed effects are unidentified or the design is rank-deficient are discarded, and the kept count is reported. Emitted by \texttt  {scripts/clustered\_inference.py} from \texttt  {scripts/cka\_fixed\_effects.py}.}}{63}{table.caption.50}\protected@file@percent }
\newlabel{tab:clustered_fe}{{36}{63}{Within-backbone slope of held-out B$-$D on CKA, in percentage points per unit of CKA, with backbone identity absorbed as a fixed effect rather than by subsetting. Intervals are $10{,}000$ cluster-bootstrap draws over the 15 $(\text {backbone}, \text {dataset})$ clusters of 31 cells; draws in which the fixed effects are unidentified or the design is rank-deficient are discarded, and the kept count is reported. Emitted by \texttt {scripts/clustered\_inference.py} from \texttt {scripts/cka\_fixed\_effects.py}}{table.caption.50}{}}
