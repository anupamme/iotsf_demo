\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces \textbf  {The corrected value gate for Chronos/M4-Monthly.} Ten denominators against one numerator (median of $20$ Chronos samples, per-window $z$-scored), on both splits. A denominator worse than \texttt  {constant}, the training-mean predictor, cannot support a claim that the checkpoint has something worth preserving: it inflates $V_{b}$ in the direction that flatters the checkpoint, which is precisely the defect that moved $17$ of $21$ Moirai cells when it was corrected (Appendix~\ref {app:gatecorrection}).}}{41}{table.caption.34}\protected@file@percent }
\newlabel{tab:chronosm4gate}{{22}{41}{\textbf {The corrected value gate for Chronos/M4-Monthly.} Ten denominators against one numerator (median of $20$ Chronos samples, per-window $z$-scored), on both splits. A denominator worse than \texttt {constant}, the training-mean predictor, cannot support a claim that the checkpoint has something worth preserving: it inflates $\Vb {b}$ in the direction that flatters the checkpoint, which is precisely the defect that moved $17$ of $21$ Moirai cells when it was corrected (Appendix~\ref {app:gatecorrection})}{table.caption.34}{}}
\@writefile{lot}{\contentsline {table}{\numberline {23}{\ignorespaces \textbf  {Conditions B and D on Chronos/M4-Monthly}, $n{=}500$ training windows, lr $10^{-5}$, batch $32$, $20$ epochs with patience $5$, early stopping on the selection windows and best epoch ${\geq }1$. Forgetting is \% change in held-out MSE against the same seed's zero-shot measurement (\emph  {negative is better than zero-shot}); $\Delta _\text  {enc}$ is the paired difference. CKA is the linear CKA of the mean-pooled final encoder output on the $200$ selection contexts, and the $\ell _2$ column is the encoder state dict's distance from pre-trained. Under condition D both are fixed \emph  {by construction} and not by measurement: on Chronos, freezing the encoder freezes the shared token embedding with it.}}{42}{table.caption.35}\protected@file@percent }
\newlabel{tab:chronosm4runs}{{23}{42}{\textbf {Conditions B and D on Chronos/M4-Monthly}, $n{=}500$ training windows, lr $10^{-5}$, batch $32$, $20$ epochs with patience $5$, early stopping on the selection windows and best epoch ${\geq }1$. Forgetting is \% change in held-out MSE against the same seed's zero-shot measurement (\emph {negative is better than zero-shot}); $\denc $ is the paired difference. CKA is the linear CKA of the mean-pooled final encoder output on the $200$ selection contexts, and the $\ell _2$ column is the encoder state dict's distance from pre-trained. Under condition D both are fixed \emph {by construction} and not by measurement: on Chronos, freezing the encoder freezes the shared token embedding with it}{table.caption.35}{}}
