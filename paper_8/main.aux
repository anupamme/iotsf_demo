\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Which timesteps Moirai is given, and which it is asked to predict}, at $h{=}96$; $h{=}192$ is the same layout with $h$ substituted. Both rows are the index arrays that \texttt  {make\_train\_sequences} and \texttt  {make\_eval\_sequences} return for window~$i$, drawn to one shared scale. At evaluation the model input is the $96{+}h$ steps \emph  {preceding} the forecast window and the target is the $h$ steps strictly after it: the two are disjoint and consecutive, so no target value reaches the model. The figure is generated from those functions' output and asserts that disjointness at draw time.}}{18}{figure.caption.8}\protected@file@percent }
\newlabel{fig:windowlayout}{{2}{18}{\textbf {Which timesteps Moirai is given, and which it is asked to predict}, at $h{=}96$; $h{=}192$ is the same layout with $h$ substituted. Both rows are the index arrays that \texttt {make\_train\_sequences} and \texttt {make\_eval\_sequences} return for window~$i$, drawn to one shared scale. At evaluation the model input is the $96{+}h$ steps \emph {preceding} the forecast window and the target is the $h$ steps strictly after it: the two are disjoint and consecutive, so no target value reaches the model. The figure is generated from those functions' output and asserts that disjointness at draw time}{figure.caption.8}{}}
