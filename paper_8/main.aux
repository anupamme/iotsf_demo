\@writefile{toc}{\contentsline {section}{\numberline {A22}Paired Inference on Encoder Adaptation, and What These Seed Counts Can Resolve}{52}{appendix.V}\protected@file@percent }
\newlabel{app:pairedinference}{{A22}{52}{Paired Inference on Encoder Adaptation, and What These Seed Counts Can Resolve}{appendix.V}{}}
\@writefile{lot}{\contentsline {table}{\numberline {30}{\ignorespaces \textbf  {Paired seed-level inference on encoder adaptation.} $\Delta _\text  {enc}={L_\text  {full}}-{L_\text  {frozen}}$ per seed, in percent of the cell's zero-shot reference, so a positive value means allowing the encoder to adapt made the cell \emph  {worse}. B and D share a seed, an initialisation and a window sample, so this contrast is paired by construction. $d$ is paired Cohen's $d$. The SEM column was dropped when $q$ was added (nine columns overrun the textwidth and the interval states the same dispersion), so \texttt  {sem} lives in \texttt  {results/paired\_inference.json}, on the body's convention (\S  \ref {sec:method}). Each row names its own $n$, which is not constant down the column (Table~\ref {tab:heldout_all}). \textbf  {$q$ is the decision column, adjusted for the 31 tests}: Benjamini--Hochberg within this contrast, with the three-way call (freeze-decisive, adapt-decisive, inconclusive) read off $q{<}0.05$ and the sign of $\Delta _\text  {enc}$, and bolded where decisive. BH runs on $p_t$, not $p_\text  {exact}$, because 24 cells have an exact floor of $0.25$ and a step-up procedure there would reject nothing at any effect size. \textbf  {Two tests, because neither alone is adequate at these seed counts.} $p_\text  {exact}$ assumes nothing, but its resolution is fixed by $N$: the 24 cells at $N{=}3$ cannot reach $p<0.05$ at any effect size, their smallest attainable value being $0.25$. $p_t$ and the interval do resolve there, and pay for it with a normality assumption on three points that cannot be checked. Both are shown so that a reading resting on that assumption is visible as one; the text states why no bootstrap interval is reported. In the two summary rows the last column is \emph  {not} an effect size: it gives the number of cells whose mean $\Delta _\text  {enc}$ is positive, out of the cells in that row. $\dagger $ marks cells clearing the gate threshold under at least one admissible baseline of the ladder (Appendix~\ref {app:baselines}). $\ddagger $ marks the Chronos cells, whose per-condition forgetting is confounded by the head/decoder mismatch; their $\Delta _\text  {enc}$ is unaffected.}}{54}{table.caption.42}\protected@file@percent }
\newlabel{tab:paired_inference}{{30}{54}{\textbf {Paired seed-level inference on encoder adaptation.} $\Delta _\text {enc}={L_\text {full}}-{L_\text {frozen}}$ per seed, in percent of the cell's zero-shot reference, so a positive value means allowing the encoder to adapt made the cell \emph {worse}. B and D share a seed, an initialisation and a window sample, so this contrast is paired by construction. $d$ is paired Cohen's $d$. The SEM column was dropped when $q$ was added (nine columns overrun the textwidth and the interval states the same dispersion), so \texttt {sem} lives in \texttt {results/paired\_inference.json}, on the body's convention (\S \ref {sec:method}). Each row names its own $n$, which is not constant down the column (Table~\ref {tab:heldout_all}). \textbf {$q$ is the decision column, adjusted for the 31 tests}: Benjamini--Hochberg within this contrast, with the three-way call (freeze-decisive, adapt-decisive, inconclusive) read off $q{<}0.05$ and the sign of $\denc $, and bolded where decisive. BH runs on $p_t$, not $p_\text {exact}$, because 24 cells have an exact floor of $0.25$ and a step-up procedure there would reject nothing at any effect size. \textbf {Two tests, because neither alone is adequate at these seed counts.} $p_\text {exact}$ assumes nothing, but its resolution is fixed by $N$: the 24 cells at $N{=}3$ cannot reach $p<0.05$ at any effect size, their smallest attainable value being $0.25$. $p_t$ and the interval do resolve there, and pay for it with a normality assumption on three points that cannot be checked. Both are shown so that a reading resting on that assumption is visible as one; the text states why no bootstrap interval is reported. In the two summary rows the last column is \emph {not} an effect size: it gives the number of cells whose mean $\Delta _\text {enc}$ is positive, out of the cells in that row. $\dagger $ marks cells clearing the gate threshold under at least one admissible baseline of the ladder (Appendix~\ref {app:baselines}). $\ddagger $ marks the Chronos cells, whose per-condition forgetting is confounded by the head/decoder mismatch; their $\Delta _\text {enc}$ is unaffected}{table.caption.42}{}}
\@writefile{lot}{\contentsline {table}{\numberline {31}{\ignorespaces \textbf  {What each surviving cell's own seed budget could detect.} The 7 cells clearing $V_{\text  {ridge}}{\geq }0.20$, with the minimum detectable effect implied by their own dispersion: MDE $= t_{1-\alpha /2,n-1}\,\text  {sd}/\sqrt  {n}$, the smallest $|\Delta _\text  {enc}|$ a two-sided paired $t$ would resolve at that $n$. $n^\star $ is the paired seed count at which the \emph  {observed} effect would resolve, holding the observed sd fixed; it is therefore a post-hoc estimate and not a design calculation. \textbf  {Two columns, because a single test and a decisive call cost different budgets.} $n^\star $ is computed at an uncorrected $\alpha {=}0.05$; $n^\star _\text  {adj}$ is computed at $\alpha /m$ with $m{=}31$ tests, which bounds the Benjamini--Hochberg threshold the call in Table~\ref {tab:paired_inference} actually uses from below and so bounds the budget from above. Reporting only $n^\star $ would say Moirai-Base/ETTh2 $h{=}192$ is already resolved at $n{=}3$, which its own $q{=}0.018$ happens to agree with, and would say the same of $h{=}96$, whose $q$ is $0.071$. \textbf  {The 4 starred rows are the point of the table}: they need more than our feasibility cap of 20 paired seeds ($\approx $20 GPU-hours per cell at two fine-tunes per seed), so we report them as \emph  {unresolvable under this design}, with the number, rather than as effects that are absent.}}{55}{table.caption.43}\protected@file@percent }
\newlabel{tab:power_mde}{{31}{55}{\textbf {What each surviving cell's own seed budget could detect.} The 7 cells clearing $\Vb {\text {ridge}}{\geq }0.20$, with the minimum detectable effect implied by their own dispersion: MDE $= t_{1-\alpha /2,n-1}\,\text {sd}/\sqrt {n}$, the smallest $|\denc |$ a two-sided paired $t$ would resolve at that $n$. $n^\star $ is the paired seed count at which the \emph {observed} effect would resolve, holding the observed sd fixed; it is therefore a post-hoc estimate and not a design calculation. \textbf {Two columns, because a single test and a decisive call cost different budgets.} $n^\star $ is computed at an uncorrected $\alpha {=}0.05$; $n^\star _\text {adj}$ is computed at $\alpha /m$ with $m{=}31$ tests, which bounds the Benjamini--Hochberg threshold the call in Table~\ref {tab:paired_inference} actually uses from below and so bounds the budget from above. Reporting only $n^\star $ would say Moirai-Base/ETTh2 $h{=}192$ is already resolved at $n{=}3$, which its own $q{=}0.018$ happens to agree with, and would say the same of $h{=}96$, whose $q$ is $0.071$. \textbf {The 4 starred rows are the point of the table}: they need more than our feasibility cap of 20 paired seeds ($\approx $20 GPU-hours per cell at two fine-tunes per seed), so we report them as \emph {unresolvable under this design}, with the number, rather than as effects that are absent}{table.caption.43}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A23}The Graded Value Axis: Is the Dissociation Confined to Cells With Nothing to Lose?}{56}{appendix.W}\protected@file@percent }
\newlabel{app:valueaxis}{{A23}{56}{The Graded Value Axis: Is the Dissociation Confined to Cells With Nothing to Lose?}{appendix.W}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Neither drift nor measured pre-trained value orders the encoder intervention.} Both panels share $y{=}$ held-out $\Delta _\text  {enc}$ (positive $=$ freezing the encoder did better). Point area is proportional to the graded value score in \emph  {both} panels, so the left panel answers the objection visually: if drift predicted the outcome wherever there was something to lose, the large points would trend and the small ones would scatter. Backbone is encoded by colour \emph  {and} marker because CKA is not comparable across architectures, which is why the pooled left-panel interval must not be read as a within-backbone one. Drawn by \texttt  {paper\_8/fig\_value\_axis.py} from \texttt  {results/value\_axis.json}; the script asserts its own counts against that file and fails rather than drawing a figure that disagrees with this text.}}{56}{figure.caption.44}\protected@file@percent }
\newlabel{fig:valueaxis}{{6}{56}{\textbf {Neither drift nor measured pre-trained value orders the encoder intervention.} Both panels share $y{=}$ held-out $\denc $ (positive $=$ freezing the encoder did better). Point area is proportional to the graded value score in \emph {both} panels, so the left panel answers the objection visually: if drift predicted the outcome wherever there was something to lose, the large points would trend and the small ones would scatter. Backbone is encoded by colour \emph {and} marker because CKA is not comparable across architectures, which is why the pooled left-panel interval must not be read as a within-backbone one. Drawn by \texttt {paper\_8/fig\_value\_axis.py} from \texttt {results/value\_axis.json}; the script asserts its own counts against that file and fails rather than drawing a figure that disagrees with this text}{figure.caption.44}{}}
\@writefile{lot}{\contentsline {table}{\numberline {32}{\ignorespaces \textbf  {The dependence, estimated two ways.} Rank rows are Spearman $\rho $ with $10{,}000$ bootstrap draws over $(\text  {backbone}, \text  {dataset})$ clusters, seed~$0$. The slope rows fit all cells at once with backbone identity absorbed as a fixed effect and both regressors centred, so $b_1$ is the CKA slope \emph  {at mean value}; $b_3$ is the quantity at issue. Emitted by \texttt  {scripts/value\_axis.py --latex}, which delegates the slope fit to \texttt  {scripts/cka\_fixed\_effects.py} rather than refitting it.}}{57}{table.caption.45}\protected@file@percent }
\newlabel{tab:valueaxis}{{32}{57}{\textbf {The dependence, estimated two ways.} Rank rows are Spearman $\rho $ with $10{,}000$ bootstrap draws over $(\text {backbone}, \text {dataset})$ clusters, seed~$0$. The slope rows fit all cells at once with backbone identity absorbed as a fixed effect and both regressors centred, so $b_1$ is the CKA slope \emph {at mean value}; $b_3$ is the quantity at issue. Emitted by \texttt {scripts/value\_axis.py --latex}, which delegates the slope fit to \texttt {scripts/cka\_fixed\_effects.py} rather than refitting it}{table.caption.45}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A24}Cross-Cell Statistics, and a Pooled Analysis We Do Not License}{57}{appendix.X}\protected@file@percent }
\newlabel{app:crosscell}{{A24}{57}{Cross-Cell Statistics, and a Pooled Analysis We Do Not License}{appendix.X}{}}
\@writefile{lot}{\contentsline {table}{\numberline {33}{\ignorespaces Is the pooled CKA correlation a backbone artefact? The same statistic (Spearman $\rho $ of CKA against held-out B$-$D, $10{,}000$-resample bootstrap CI) computed pooled and then stratified by backbone, at both resampling levels. ``Cl.'' is the number of $(\text  {backbone}, \text  {dataset})$ clusters, which is the effective sample size for the clustered interval and is far below $n$. Values are emitted by \texttt  {scripts/clustered\_inference.py}. The pooled row is reported for audit, not read as evidence; the two small arms carry essentially no information at their cell counts, and for them the two levels coincide because every cell is already its own cluster.}}{58}{table.caption.46}\protected@file@percent }
\newlabel{tab:crosscell}{{33}{58}{Is the pooled CKA correlation a backbone artefact? The same statistic (Spearman $\rho $ of CKA against held-out B$-$D, $10{,}000$-resample bootstrap CI) computed pooled and then stratified by backbone, at both resampling levels. ``Cl.'' is the number of $(\text {backbone}, \text {dataset})$ clusters, which is the effective sample size for the clustered interval and is far below $n$. Values are emitted by \texttt {scripts/clustered\_inference.py}. The pooled row is reported for audit, not read as evidence; the two small arms carry essentially no information at their cell counts, and for them the two levels coincide because every cell is already its own cluster}{table.caption.46}{}}
\@writefile{lot}{\contentsline {table}{\numberline {34}{\ignorespaces \textbf  {The within-backbone dissociation, one capacity, eight cells.} Every Moirai-Base cell, ordered by CKA (most drifted first). ``Full FT'' and ``Frozen'' are percent change in held-out MSE against zero-shot, so negative is better and positive is task-level forgetting; $\Delta _\text  {enc}$ is the manipulated contrast between them. Gate values marked~\textsuperscript  {f} fail the $0.20$ screen. Reading down the CKA column, the outcome reverses sign: the two least drifted cells are the only two that degrade. Emitted by \texttt  {scripts/emit\_dissociation.py}, which asserts both of those claims against the run records and exits non-zero if they stop holding; these four CKA values and four percentages were previously quoted in body prose alone.}}{59}{table.caption.47}\protected@file@percent }
\newlabel{tab:dissociation}{{34}{59}{\textbf {The within-backbone dissociation, one capacity, eight cells.} Every Moirai-Base cell, ordered by CKA (most drifted first). ``Full FT'' and ``Frozen'' are percent change in held-out MSE against zero-shot, so negative is better and positive is task-level forgetting; $\denc $ is the manipulated contrast between them. Gate values marked~\textsuperscript {f} fail the $0.20$ screen. Reading down the CKA column, the outcome reverses sign: the two least drifted cells are the only two that degrade. Emitted by \texttt {scripts/emit\_dissociation.py}, which asserts both of those claims against the run records and exits non-zero if they stop holding; these four CKA values and four percentages were previously quoted in body prose alone}{table.caption.47}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A25}Is the Reading Specific to CKA? Six Measures on 59 Encoders}{59}{appendix.Y}\protected@file@percent }
\newlabel{app:driftmetrics}{{A25}{59}{Is the Reading Specific to CKA? Six Measures on 59 Encoders}{appendix.Y}{}}
\@writefile{lot}{\contentsline {table}{\numberline {35}{\ignorespaces \textbf  {Six measures of representation change on 59 Moirai-Small encoders.} All computed on identical windows and identical pooling. ``$\rho $ with CKA'' is the rank correlation of each measure with linear CKA over the 59 encoders; the last two columns correlate each measure with forgetting, pooled and then within each of the six groups of at least five encoders. Forgetting here is the \emph  {selection-split} figure: these runs stored no zero-shot test MSE, so a held-out contrast cannot be reconstructed from them, and \S  \ref {sec:analysis:heldout} shows same-split scoring can invert the sign of the intervention. This arm is therefore a comparison of measures, not a held-out claim. Emitted by \texttt  {scripts/drift\_metric\_battery.py}; the pooled column mixes three datasets and is descriptive for the reason Appendix~\ref {app:crosscell} gives about pooling.}}{60}{table.caption.48}\protected@file@percent }
\newlabel{tab:driftmetrics}{{35}{60}{\textbf {Six measures of representation change on 59 Moirai-Small encoders.} All computed on identical windows and identical pooling. ``$\rho $ with CKA'' is the rank correlation of each measure with linear CKA over the 59 encoders; the last two columns correlate each measure with forgetting, pooled and then within each of the six groups of at least five encoders. Forgetting here is the \emph {selection-split} figure: these runs stored no zero-shot test MSE, so a held-out contrast cannot be reconstructed from them, and \S \ref {sec:analysis:heldout} shows same-split scoring can invert the sign of the intervention. This arm is therefore a comparison of measures, not a held-out claim. Emitted by \texttt {scripts/drift\_metric\_battery.py}; the pooled column mixes three datasets and is descriptive for the reason Appendix~\ref {app:crosscell} gives about pooling}{table.caption.48}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {The screen's own axis.} All 31 intervention cells as the selection-split gate against held-out $\Delta _\text  {enc}$ (positive ${=}$ freezing better). Filled markers clear $V_{\text  {ridge}}{\geq }0.20$; the shaded strip is the only region a cell could occupy and still satisfy clause~(i) of the degradation definition, and most of the cells in it lie \emph  {below} zero, where letting the encoder adapt helped. The two axes are scored on disjoint window sets, so a cell's horizontal position is not a re-description of its vertical one. ILI is named on the frame rather than plotted: its gate is $-10.21$, and an axis wide enough to include it compresses the other 30 cells into a fifth of the panel.}}{61}{figure.caption.49}\protected@file@percent }
\newlabel{fig:gatescatter}{{7}{61}{\textbf {The screen's own axis.} All 31 intervention cells as the selection-split gate against held-out $\denc $ (positive ${=}$ freezing better). Filled markers clear $\Vb {\text {ridge}}{\geq }0.20$; the shaded strip is the only region a cell could occupy and still satisfy clause~(i) of the degradation definition, and most of the cells in it lie \emph {below} zero, where letting the encoder adapt helped. The two axes are scored on disjoint window sets, so a cell's horizontal position is not a re-description of its vertical one. ILI is named on the frame rather than plotted: its gate is $-10.21$, and an axis wide enough to include it compresses the other 30 cells into a fifth of the panel}{figure.caption.49}{}}
