\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Sample-size sweep on ETTh2 ($h{=}96$, condition~B). Drift grows monotonically (CKA$\downarrow $ as $n\uparrow $); forgetting is \emph  {non-monotonic}: severe at $n{\le }1{,}000$, resolved at $n{=}2{,}000$, with elevated variance at $n{=}5{,}000$ (crossover regime). At $n{=}10{,}000$: CUDA 10-seed deterministic early-stopped, $7/10$ negative forgetting; \textbf  {10/10} $\Delta R^2{>}0$ (per-seed values in Appendix~\ref {app:probing}). $\Delta R^2$ is a \emph  {relative} signal: absolute $R^2(\text  {FT})$ remains negative ($R^2_{\text  {ZS}}{=}{-}6.90$ for all rows). Ridge $\Delta R^2$ at $n{=}500$ ($k{=}2$) and $n{=}1{,}000$ ($k{=}1$): point values only.}}{5}{table.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:sample_sweep}{{1}{5}{Sample-size sweep on ETTh2 ($h{=}96$, condition~B). Drift grows monotonically (CKA$\downarrow $ as $n\uparrow $); forgetting is \emph {non-monotonic}: severe at $n{\le }1{,}000$, resolved at $n{=}2{,}000$, with elevated variance at $n{=}5{,}000$ (crossover regime). At $n{=}10{,}000$: CUDA 10-seed deterministic early-stopped, $7/10$ negative forgetting; \textbf {10/10} $\Delta R^2{>}0$ (per-seed values in Appendix~\ref {app:probing}). $\Delta R^2$ is a \emph {relative} signal: absolute $R^2(\text {FT})$ remains negative ($R^2_{\text {ZS}}{=}{-}6.90$ for all rows). Ridge $\Delta R^2$ at $n{=}500$ ($k{=}2$) and $n{=}1{,}000$ ($k{=}1$): point values only}{table.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Cost--benefit dynamics on Moirai-Small/ETTh2 (condition B, $h{=}96$). (a)~\textbf  {Geometric drift}: CKA decays monotonically with $n$; blue circles = final-epoch, red square = early-stopped at $n{=}10$k. (b)~Trained-head Ridge $\Delta R^2$ rises with $n$ (same protocol markers). (c)~\textbf  {Probe asymmetry} at $n{=}10$k (the load-bearing empirical signal): trained head $\Delta R^2{>}0$ (blue) vs.\ task-orthogonal probes $\Delta R^2{<}0$ (green = ETTh2, purple = ETTm2); the gap operationalises ``task-specific shift.'' (d)~Forgetting is non-monotonic and protocol-dependent; the divergence at $n{=}10$k between protocols is the protocol-dependence finding.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:dissociation}{{1}{5}{Cost--benefit dynamics on Moirai-Small/ETTh2 (condition B, $h{=}96$). (a)~\textbf {Geometric drift}: CKA decays monotonically with $n$; blue circles = final-epoch, red square = early-stopped at $n{=}10$k. (b)~Trained-head Ridge $\Delta R^2$ rises with $n$ (same protocol markers). (c)~\textbf {Probe asymmetry} at $n{=}10$k (the load-bearing empirical signal): trained head $\Delta R^2{>}0$ (blue) vs.\ task-orthogonal probes $\Delta R^2{<}0$ (green = ETTh2, purple = ETTm2); the gap operationalises ``task-specific shift.'' (d)~Forgetting is non-monotonic and protocol-dependent; the divergence at $n{=}10$k between protocols is the protocol-dependence finding}{figure.caption.3}{}}
\newlabel{sec:forecasting:probehead}{{4.4}{5}{Sample-Size Sweep: Drift--Forgetting Dynamics}{figure.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Task-native probe $R^2_{\text  {task}}$ at key $(n, h)$ operating points (condition B, mean over available seeds). $R^2_{\text  {task}}(\text  {PT}) {=} 1 {-} \text  {MSE}_{\text  {ZS}}/\text  {MSE}_{\text  {Linear}}$ uses the gate-pass evaluation scale (median Moirai prediction, lookback$=$192, linear baseline lookback$=$96, train-normalised). $\Delta R^2_{\text  {task}} {=} {-}(1{-}R^2_{\text  {task}}(\text  {PT})) {\times } \mathrm  {Forg\%}/100$ (sign is scale-independent; see \S  \ref {sec:forecasting:probehead}). The $n{=}10$k rows use early-stopped (ES) forgetting. ETTh2 is the \textbf  {gate-pass} anchor ($R^2_{\text  {task}}(\text  {PT}){>}0.2$); ETTm2 and ETTh1 are \textbf  {cross-domain comparisons} that gate-fail and are included to show drift behaviour outside the gate-pass regime.}}{6}{table.caption.4}\protected@file@percent }
\newlabel{tab:r2task}{{2}{6}{Task-native probe $R^2_{\text {task}}$ at key $(n, h)$ operating points (condition B, mean over available seeds). $R^2_{\text {task}}(\text {PT}) {=} 1 {-} \text {MSE}_{\text {ZS}}/\text {MSE}_{\text {Linear}}$ uses the gate-pass evaluation scale (median Moirai prediction, lookback$=$192, linear baseline lookback$=$96, train-normalised). $\Delta R^2_{\text {task}} {=} {-}(1{-}R^2_{\text {task}}(\text {PT})) {\times } \mathrm {Forg\%}/100$ (sign is scale-independent; see \S \ref {sec:forecasting:probehead}). The $n{=}10$k rows use early-stopped (ES) forgetting. ETTh2 is the \textbf {gate-pass} anchor ($R^2_{\text {task}}(\text {PT}){>}0.2$); ETTm2 and ETTh1 are \textbf {cross-domain comparisons} that gate-fail and are included to show drift behaviour outside the gate-pass regime}{table.caption.4}{}}
