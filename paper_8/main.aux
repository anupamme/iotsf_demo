\@writefile{toc}{\contentsline {section}{\numberline {A29}Audit Trail and Withdrawn Analyses}{64}{appendix.Alph29}\protected@file@percent }
\newlabel{app:audit}{{A29}{64}{Audit Trail and Withdrawn Analyses}{appendix.Alph29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {37}{\ignorespaces \textbf  {Does CKA add out-of-sample predictive information about $\Delta _\text  {enc}$ beyond backbone identity?} Nested models over all 31 scored cells, validated by leave-one-cluster-out across the 15 (backbone, dataset) clusters. $R^2_\text  {LOCO}$ is scored \textbf  {against the training-fold mean}, never the held-out fold's own mean, so a positive value means the model beats predicting the other clusters' average; MAE is in percentage points of zero-shot loss. \textbf  {The deciding statistic and this table's interpretation were fixed before the models were fitted} (\texttt  {results/preregister\_loco.json}): $\Delta R^2 = R^2_\text  {LOCO}(\text  {M3}) - R^2_\text  {LOCO}(\text  {M2}) = -0.025$, median bootstrap draw $-0.083$, IQR $[-0.227, +0.043]$, and adding CKA fails to help in 69\% of draws; $\Delta \text  {MAE} = +0.59$~pp, IQR $[-0.37, +2.98]$. \textbf  {Interquartile ranges, not 95\% intervals, are quoted for both}: an out-of-sample $R^2$ is unbounded below and a degenerate bootstrap fold can blow up either statistic, so their extreme percentiles are not reproducible: $\Delta R^2$'s 2.5th percentile moved between $-1.7$ and $-32.5$ across bootstrap seeds, and $\Delta $MAE's 97.5th between $+11$ and $+19$, while the point estimates, medians and sign share moved in the third decimal. \textbf  {The 95\% interval is carried instead by the one linear coefficient here}, CKA's slope in M3: $+43$~pp per unit CKA, cluster-bootstrap CI $[-31, +107]$, which covers zero, so the slope's sign is not even determined, let alone its size. That interval is quoted to whole percentage points because its bounds move by under 5~pp across bootstrap seeds. The pre-registered deciding statistic (the \emph  {sign} of $\Delta R^2$) is unchanged; only the dispersion measure beside it differs from the registration, which says so. Dataset identity is deliberately \emph  {absent} from the ladder: a cluster is a (backbone, dataset) pair, so holding one out removes the only cells that identify that dataset's fixed effect and the fold would silently score a model nobody specified: three of the 7 series are covered by a single backbone, so no other fold could identify them even in principle. The in-sample fit \emph  {with} dataset fixed effects is reported in the text and is not validation.}}{65}{table.caption.51}\protected@file@percent }
\newlabel{tab:cka_loco}{{37}{65}{\textbf {Does CKA add out-of-sample predictive information about $\denc $ beyond backbone identity?} Nested models over all 31 scored cells, validated by leave-one-cluster-out across the 15 (backbone, dataset) clusters. $R^2_\text {LOCO}$ is scored \textbf {against the training-fold mean}, never the held-out fold's own mean, so a positive value means the model beats predicting the other clusters' average; MAE is in percentage points of zero-shot loss. \textbf {The deciding statistic and this table's interpretation were fixed before the models were fitted} (\texttt {results/preregister\_loco.json}): $\Delta R^2 = R^2_\text {LOCO}(\text {M3}) - R^2_\text {LOCO}(\text {M2}) = -0.025$, median bootstrap draw $-0.083$, IQR $[-0.227, +0.043]$, and adding CKA fails to help in 69\% of draws; $\Delta \text {MAE} = +0.59$~pp, IQR $[-0.37, +2.98]$. \textbf {Interquartile ranges, not 95\% intervals, are quoted for both}: an out-of-sample $R^2$ is unbounded below and a degenerate bootstrap fold can blow up either statistic, so their extreme percentiles are not reproducible: $\Delta R^2$'s 2.5th percentile moved between $-1.7$ and $-32.5$ across bootstrap seeds, and $\Delta $MAE's 97.5th between $+11$ and $+19$, while the point estimates, medians and sign share moved in the third decimal. \textbf {The 95\% interval is carried instead by the one linear coefficient here}, CKA's slope in M3: $+43$~pp per unit CKA, cluster-bootstrap CI $[-31, +107]$, which covers zero, so the slope's sign is not even determined, let alone its size. That interval is quoted to whole percentage points because its bounds move by under 5~pp across bootstrap seeds. The pre-registered deciding statistic (the \emph {sign} of $\Delta R^2$) is unchanged; only the dispersion measure beside it differs from the registration, which says so. Dataset identity is deliberately \emph {absent} from the ladder: a cluster is a (backbone, dataset) pair, so holding one out removes the only cells that identify that dataset's fixed effect and the fold would silently score a model nobody specified: three of the 7 series are covered by a single backbone, so no other fold could identify them even in principle. The in-sample fit \emph {with} dataset fixed effects is reported in the text and is not validation}{table.caption.51}{}}
