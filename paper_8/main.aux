\@writefile{lot}{\contentsline {table}{\numberline {29}{\ignorespaces Is the pooled CKA correlation a backbone artefact? The same statistic (Spearman $\rho $ of CKA against held-out B$-$D, $10{,}000$-resample bootstrap CI) computed pooled and then stratified by backbone, at both resampling levels. ``Cl.'' is the number of $(\text  {backbone}, \text  {dataset})$ clusters, which is the effective sample size for the clustered interval and is far below $n$. Values are emitted by \texttt  {scripts/clustered\_inference.py}. The pooled row is reported for audit, not read as evidence; the two small arms carry essentially no information at their cell counts, and for them the two levels coincide because every cell is already its own cluster.}}{52}{table.caption.41}\protected@file@percent }
\newlabel{tab:crosscell}{{29}{52}{Is the pooled CKA correlation a backbone artefact? The same statistic (Spearman $\rho $ of CKA against held-out B$-$D, $10{,}000$-resample bootstrap CI) computed pooled and then stratified by backbone, at both resampling levels. ``Cl.'' is the number of $(\text {backbone}, \text {dataset})$ clusters, which is the effective sample size for the clustered interval and is far below $n$. Values are emitted by \texttt {scripts/clustered\_inference.py}. The pooled row is reported for audit, not read as evidence; the two small arms carry essentially no information at their cell counts, and for them the two levels coincide because every cell is already its own cluster}{table.caption.41}{}}
\@writefile{lot}{\contentsline {table}{\numberline {30}{\ignorespaces \textbf  {The within-backbone dissociation, one capacity, eight cells.} Every Moirai-Base cell, ordered by CKA (most drifted first). ``Full FT'' and ``Frozen'' are percent change in held-out MSE against zero-shot, so negative is better and positive is task-level forgetting; $\Delta _\text  {enc}$ is the manipulated contrast between them. Gate values marked~\textsuperscript  {f} fail the $0.20$ screen. Reading down the CKA column, the outcome reverses sign: the two least drifted cells are the only two that degrade. Emitted by \texttt  {scripts/emit\_dissociation.py}, which asserts both of those claims against the run records and exits non-zero if they stop holding---these four CKA values and four percentages were previously quoted in body prose alone.}}{53}{table.caption.42}\protected@file@percent }
\newlabel{tab:dissociation}{{30}{53}{\textbf {The within-backbone dissociation, one capacity, eight cells.} Every Moirai-Base cell, ordered by CKA (most drifted first). ``Full FT'' and ``Frozen'' are percent change in held-out MSE against zero-shot, so negative is better and positive is task-level forgetting; $\denc $ is the manipulated contrast between them. Gate values marked~\textsuperscript {f} fail the $0.20$ screen. Reading down the CKA column, the outcome reverses sign: the two least drifted cells are the only two that degrade. Emitted by \texttt {scripts/emit\_dissociation.py}, which asserts both of those claims against the run records and exits non-zero if they stop holding---these four CKA values and four percentages were previously quoted in body prose alone}{table.caption.42}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A25}Is the Reading Specific to CKA? Six Measures on 59 Encoders}{53}{appendix.Y}\protected@file@percent }
\newlabel{app:driftmetrics}{{A25}{53}{Is the Reading Specific to CKA? Six Measures on 59 Encoders}{appendix.Y}{}}
\@writefile{lot}{\contentsline {table}{\numberline {31}{\ignorespaces \textbf  {Six measures of representation change on 59 Moirai-Small encoders.} All computed on identical windows and identical pooling. ``$\rho $ with CKA'' is the rank correlation of each measure with linear CKA over the 59 encoders; the last two columns correlate each measure with forgetting, pooled and then within each of the six groups of at least five encoders. Forgetting here is the \emph  {selection-split} figure---these runs stored no zero-shot test MSE, so a held-out contrast cannot be reconstructed from them, and \S  \ref {sec:analysis:heldout} shows same-split scoring can invert the sign of the intervention. This arm is therefore a comparison of measures, not a held-out claim. Emitted by \texttt  {scripts/drift\_metric\_battery.py}; the pooled column mixes three datasets and is descriptive for the reason Appendix~\ref {app:crosscell} gives about pooling.}}{54}{table.caption.43}\protected@file@percent }
\newlabel{tab:driftmetrics}{{31}{54}{\textbf {Six measures of representation change on 59 Moirai-Small encoders.} All computed on identical windows and identical pooling. ``$\rho $ with CKA'' is the rank correlation of each measure with linear CKA over the 59 encoders; the last two columns correlate each measure with forgetting, pooled and then within each of the six groups of at least five encoders. Forgetting here is the \emph {selection-split} figure---these runs stored no zero-shot test MSE, so a held-out contrast cannot be reconstructed from them, and \S \ref {sec:analysis:heldout} shows same-split scoring can invert the sign of the intervention. This arm is therefore a comparison of measures, not a held-out claim. Emitted by \texttt {scripts/drift\_metric\_battery.py}; the pooled column mixes three datasets and is descriptive for the reason Appendix~\ref {app:crosscell} gives about pooling}{table.caption.43}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {The screen's own axis.} All 31 intervention cells as the selection-split gate against held-out $\Delta _\text  {enc}$ (positive ${=}$ freezing better). Filled markers clear $V_{\text  {ridge}}{\geq }0.20$; the shaded strip is the only region a cell could occupy and still satisfy clause~(i) of the degradation definition, and most of the cells in it lie \emph  {below} zero, where letting the encoder adapt helped. The two axes are scored on disjoint window sets, so a cell's horizontal position is not a re-description of its vertical one. ILI is named on the frame rather than plotted: its gate is $-10.21$, and an axis wide enough to include it compresses the other 30 cells into a fifth of the panel.}}{55}{figure.caption.44}\protected@file@percent }
\newlabel{fig:gatescatter}{{7}{55}{\textbf {The screen's own axis.} All 31 intervention cells as the selection-split gate against held-out $\denc $ (positive ${=}$ freezing better). Filled markers clear $\Vb {\text {ridge}}{\geq }0.20$; the shaded strip is the only region a cell could occupy and still satisfy clause~(i) of the degradation definition, and most of the cells in it lie \emph {below} zero, where letting the encoder adapt helped. The two axes are scored on disjoint window sets, so a cell's horizontal position is not a re-description of its vertical one. ILI is named on the frame rather than plotted: its gate is $-10.21$, and an axis wide enough to include it compresses the other 30 cells into a fifth of the panel}{figure.caption.44}{}}
