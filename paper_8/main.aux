\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Cost--benefit dynamics on Moirai-Small/ETTh2 (condition B, $h{=}96$). (a)~CKA decays monotonically with $n$ (final-epoch vs.\ early-stopped markers); (d)~forgetting is non-monotonic and protocol-dependent. Panels~(b) and~(c) plot the linear-probe $\Delta R^2$ statistic and its sign asymmetry, both \textbf  {retracted} (\S  \ref {sec:retraction}); they are reproduced unaltered as a record of the withdrawn analysis and support no claim here. The dissociation this figure is cited for is the contrast between (a) and (d): drift monotone in $n$, outcome not.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:dissociation}{{1}{7}{Cost--benefit dynamics on Moirai-Small/ETTh2 (condition B, $h{=}96$). (a)~CKA decays monotonically with $n$ (final-epoch vs.\ early-stopped markers); (d)~forgetting is non-monotonic and protocol-dependent. Panels~(b) and~(c) plot the linear-probe $\Delta R^2$ statistic and its sign asymmetry, both \textbf {retracted} (\S \ref {sec:retraction}); they are reproduced unaltered as a record of the withdrawn analysis and support no claim here. The dissociation this figure is cited for is the contrast between (a) and (d): drift monotone in $n$, outcome not}{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Task-native score $R^2_{\text  {task}}$ at key $(n, h)$ operating points. \textbf  {Not a linear probe}: this is a ratio of forecast MSEs computed through Moirai's own forecasting head, and is unaffected by the retraction of the linear-probe $\Delta R^2$ axis (\S  \ref {sec:retraction}). (condition B, mean over available seeds). $R^2_{\text  {task}}(\text  {PT}) {=} 1 {-} \text  {MSE}_{\text  {ZS}}/\text  {MSE}_{\text  {Linear}}$ uses the gate-pass evaluation scale (median Moirai prediction, lookback$=$192, linear baseline lookback$=$96, train-normalised). $\Delta R^2_{\text  {task}} {=} {-}(1{-}R^2_{\text  {task}}(\text  {PT})) {\times } \mathrm  {Forg\%}/100$ (sign is scale-independent; see \S  \ref {sec:forecasting:probehead}). The $n{=}10$k rows use early-stopped (ES) forgetting. ETTh2 is the \textbf  {gate-pass} anchor ($R^2_{\text  {task}}(\text  {PT}){>}0.2$); ETTm2 and ETTh1 are \textbf  {cross-domain comparisons} that gate-fail and are included to show drift behaviour outside the gate-pass regime.}}{7}{table.caption.6}\protected@file@percent }
\newlabel{tab:r2task}{{4}{7}{Task-native score $R^2_{\text {task}}$ at key $(n, h)$ operating points. \textbf {Not a linear probe}: this is a ratio of forecast MSEs computed through Moirai's own forecasting head, and is unaffected by the retraction of the linear-probe $\Delta R^2$ axis (\S \ref {sec:retraction}). (condition B, mean over available seeds). $R^2_{\text {task}}(\text {PT}) {=} 1 {-} \text {MSE}_{\text {ZS}}/\text {MSE}_{\text {Linear}}$ uses the gate-pass evaluation scale (median Moirai prediction, lookback$=$192, linear baseline lookback$=$96, train-normalised). $\Delta R^2_{\text {task}} {=} {-}(1{-}R^2_{\text {task}}(\text {PT})) {\times } \mathrm {Forg\%}/100$ (sign is scale-independent; see \S \ref {sec:forecasting:probehead}). The $n{=}10$k rows use early-stopped (ES) forgetting. ETTh2 is the \textbf {gate-pass} anchor ($R^2_{\text {task}}(\text {PT}){>}0.2$); ETTm2 and ETTh1 are \textbf {cross-domain comparisons} that gate-fail and are included to show drift behaviour outside the gate-pass regime}{table.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Diagnostic summary. Gate$=$gate-pass\%; Drift$=$CKA${<}$0.95. The Asym.\ column recorded the probe-sign asymmetry, which is \textbf  {retracted} (\S  \ref {sec:retraction}); it is retained only as a record of the withdrawn computation and carries no claim. All Moirai-Small unless noted. Full numerics in text.}}{8}{table.caption.7}\protected@file@percent }
\newlabel{tab:cross_domain}{{5}{8}{Diagnostic summary. Gate$=$gate-pass\%; Drift$=$CKA${<}$0.95. The Asym.\ column recorded the probe-sign asymmetry, which is \textbf {retracted} (\S \ref {sec:retraction}); it is retained only as a record of the withdrawn computation and carries no claim. All Moirai-Small unless noted. Full numerics in text}{table.caption.7}{}}
