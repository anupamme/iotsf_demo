\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The chain, and why drift cannot stand in for the intervention.} \textbf  {(a)}~The three quantities the chain keeps apart. \textbf  {(b)}~All 23 cells; red marks the six \textbf  {pretrained-capability degradation} cells. They are the \emph  {least}-drifted cells we measure (CKA $0.67$--$0.89$) while adaptation helps most at $0.09$--$0.46$, so the reflex---large drift means damage---points the wrong way. The $x$-axis is not a decision boundary: CKA is comparable only \emph  {within} a backbone, and within Moirai it does not reliably order the column ($\rho {=}{+}0.495$, CI includes $0$; App.~\ref {app:crosscell}).}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:chain}{{1}{3}{\textbf {The chain, and why drift cannot stand in for the intervention.} \textbf {(a)}~The three quantities the chain keeps apart. \textbf {(b)}~All 23 cells; red marks the six \textbf {pretrained-capability degradation} cells. They are the \emph {least}-drifted cells we measure (CKA $0.67$--$0.89$) while adaptation helps most at $0.09$--$0.46$, so the reflex---large drift means damage---points the wrong way. The $x$-axis is not a decision boundary: CKA is comparable only \emph {within} a backbone, and within Moirai it does not reliably order the column ($\rho {=}{+}0.495$, CI includes $0$; App.~\ref {app:crosscell})}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {The intervention spans 101~pp; drift does not order it.} Held-out B$-$D (pp): negative $=$ adaptation helps, \textbf  {positive $=$ freezing is better}. 23 cells, three backbones, 3--10 seeds; gate and B$-$D both scored on the test split. $^{\text  {f}}$gate-fails there despite passing on the selection windows; $^{*}$directional ($|$mean$|<2$\,SEM); $^{\ddagger }$B$-$D only---Chronos's head/decoder mismatch makes per-condition forgetting non-comparable (limitation~iii). \textbf  {degradation} $=$ pretrained-capability degradation (\S  \ref {sec:results}); Fig.~\ref {fig:chain}b plots all 23. Per-cell values App.~\ref {app:heldout}, statistics in App.~\ref {app:crosscell}.}}{3}{table.1}\protected@file@percent }
\newlabel{tab:regimes}{{1}{3}{\textbf {The intervention spans 101~pp; drift does not order it.} Held-out B$-$D (pp): negative $=$ adaptation helps, \textbf {positive $=$ freezing is better}. 23 cells, three backbones, 3--10 seeds; gate and B$-$D both scored on the test split. $^{\text {f}}$gate-fails there despite passing on the selection windows; $^{*}$directional ($|$mean$|<2$\,SEM); $^{\ddagger }$B$-$D only---Chronos's head/decoder mismatch makes per-condition forgetting non-comparable (limitation~iii). \textbf {degradation} $=$ pretrained-capability degradation (\S \ref {sec:results}); Fig.~\ref {fig:chain}b plots all 23. Per-cell values App.~\ref {app:heldout}, statistics in App.~\ref {app:crosscell}}{table.1}{}}
