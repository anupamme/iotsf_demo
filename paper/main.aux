\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces  Ablation study on stealth-95 and all-stealth evaluation sets. Conditions A--D, CNN, CNN-NLL use 10 seeds; E/E$'$ use 5 seeds (minor ablations). $\pm $ values are standard deviations across seeds. Threshold calibrated on benign-only held-out scores (95th percentile, targeting FPR\,$\leq $\,0.05; see Section~\ref {sec:experiments:setup}). ROC-AUC is threshold-independent and the primary ranking metric. E$''$ is analytically identical to D for the analytical perturbation pathway (100\% constraint compliance, retry never fires); all fine-tuned conditions (B--E$'$, CNN, CNN-NLL) outperform zero-shot (A). }}{8}{table.caption.3}\protected@file@percent }
\newlabel{tab:ablation}{{2}{8}{Ablation study on stealth-95 and all-stealth evaluation sets. Conditions A--D, CNN, CNN-NLL use 10 seeds; E/E$'$ use 5 seeds (minor ablations). $\pm $ values are standard deviations across seeds. Threshold calibrated on benign-only held-out scores (95th percentile, targeting FPR\,$\leq $\,0.05; see Section~\ref {sec:experiments:setup}). ROC-AUC is threshold-independent and the primary ranking metric. E$''$ is analytically identical to D for the analytical perturbation pathway (100\% constraint compliance, retry never fires); all fine-tuned conditions (B--E$'$, CNN, CNN-NLL) outperform zero-shot (A)}{table.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Scaling Experiment}{8}{subsection.5.5}\protected@file@percent }
\newlabel{sec:experiments:scaling}{{5.5}{8}{Scaling Experiment}{subsection.5.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces  Scale degradation and encoder-freezing experiment (stealth-95, benign-calibrated threshold, NLL-only early stopping). B, C, D use 10 seeds at all scales including frozen; D-DiffTS uses 10 seeds at 200/5, 5 seeds elsewhere. \textbf  {Key findings}: (1)~All conditions degrade monotonically from 200/5 onward; the 5-seed appearance of 500/10 improvement was unstable (see text). (2)~The C$>$D gap narrows from $+$0.073 (200/5) to $+$0.045 (500/10) to $+$0.024 (1000/20, n.s.). (3)~Frozen B$=$C$=$D are identical (0.549) because NLL evaluation depends only on the frozen encoder. (4)~Controlled cross-evaluation: both frozen and unfrozen D-DiffTS evaluated on the same analytical negatives as B/C/D yield AUC$\approx $0.464 ($\S  $), confirming that D-DiffTS figures evaluated on their own DiffTS negatives are evaluation-distribution artifacts. 2000/30 column shows only C, D, D-DiffTS. }}{9}{table.caption.4}\protected@file@percent }
\newlabel{tab:scaling}{{3}{9}{Scale degradation and encoder-freezing experiment (stealth-95, benign-calibrated threshold, NLL-only early stopping). B, C, D use 10 seeds at all scales including frozen; D-DiffTS uses 10 seeds at 200/5, 5 seeds elsewhere. \textbf {Key findings}: (1)~All conditions degrade monotonically from 200/5 onward; the 5-seed appearance of 500/10 improvement was unstable (see text). (2)~The C$>$D gap narrows from $+$0.073 (200/5) to $+$0.045 (500/10) to $+$0.024 (1000/20, n.s.). (3)~Frozen B$=$C$=$D are identical (0.549) because NLL evaluation depends only on the frozen encoder. (4)~Controlled cross-evaluation: both frozen and unfrozen D-DiffTS evaluated on the same analytical negatives as B/C/D yield AUC$\approx $0.464 ($\S $), confirming that D-DiffTS figures evaluated on their own DiffTS negatives are evaluation-distribution artifacts. 2000/30 column shows only C, D, D-DiffTS}{table.caption.4}{}}
