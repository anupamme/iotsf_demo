\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces  Ablation study on stealth-95 and all-stealth evaluation sets. Conditions A--D, CNN, CNN-NLL use 10 seeds; E/E$'$ use 5 seeds (minor ablations). $\pm $ values are standard deviations across seeds. Threshold calibrated on benign-only held-out scores (95th percentile, targeting FPR\,$\leq $\,0.05; see Section~\ref {sec:experiments:setup}). ROC-AUC is threshold-independent and the primary ranking metric. E$''$ is analytically identical to D for the analytical perturbation pathway (100\% constraint compliance, retry never fires); all fine-tuned conditions (B--E$'$, CNN, CNN-NLL) outperform zero-shot (A). }}{7}{table.caption.3}\protected@file@percent }
\newlabel{tab:ablation}{{2}{7}{Ablation study on stealth-95 and all-stealth evaluation sets. Conditions A--D, CNN, CNN-NLL use 10 seeds; E/E$'$ use 5 seeds (minor ablations). $\pm $ values are standard deviations across seeds. Threshold calibrated on benign-only held-out scores (95th percentile, targeting FPR\,$\leq $\,0.05; see Section~\ref {sec:experiments:setup}). ROC-AUC is threshold-independent and the primary ranking metric. E$''$ is analytically identical to D for the analytical perturbation pathway (100\% constraint compliance, retry never fires); all fine-tuned conditions (B--E$'$, CNN, CNN-NLL) outperform zero-shot (A)}{table.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}External Validation on N-BaIoT}{7}{subsection.5.6}\protected@file@percent }
