\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces  Learning-rate and LoRA ablation at 1000/20 (stealth-95, 5 seeds, benign-calibrated threshold). Frozen encoder results from Table~\ref {tab:scaling} included for reference. \textbf  {Key findings}: (1)~$10^{-5}$ partially mitigates degradation for C but not B or D. (2)~$10^{-6}$ underfits across all conditions. (3)~LoRA (rank$=$8) underperforms full freezing, suggesting low-rank adapters lack capacity for this task. (4)~Full encoder freezing remains the most effective mitigation. }}{23}{table.caption.18}\protected@file@percent }
\newlabel{tab:lr_ablation}{{13}{23}{Learning-rate and LoRA ablation at 1000/20 (stealth-95, 5 seeds, benign-calibrated threshold). Frozen encoder results from Table~\ref {tab:scaling} included for reference. \textbf {Key findings}: (1)~$10^{-5}$ partially mitigates degradation for C but not B or D. (2)~$10^{-6}$ underfits across all conditions. (3)~LoRA (rank$=$8) underperforms full freezing, suggesting low-rank adapters lack capacity for this task. (4)~Full encoder freezing remains the most effective mitigation}{table.caption.18}{}}
